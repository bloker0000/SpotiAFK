# SpotiAFK configuration. 'spotiafk setup' writes this for you, only the first four values are required,
# everything else has these defaults.

playlist = "PLAYLIST NAME"     # one of yours, or a Spotify link to play as a whole (DJ, a playlist you follow)
play_on = ["DEVICE-1"]          # Spotify device names to play on

[spotify]
client_id = "YOUR-CLIENT-ID"
client_secret = "YOUR-CLIENT-SECRET"
# redirect_uri = "http://127.0.0.1:8888/callback/"

# [playback]
# skip_after = 0                # 0 plays tracks in full, or seconds per track (min 31)
# shuffle = true
# hand_back = true              # on takeover, put your last track back on your device;
#                               # turn off when play_on is a device you also listen on

# [checks]
# idle_minutes = 15             # nothing playing this long before it starts
# interval = 30                 # seconds between checks
# retry = 10                    # seconds before retrying after an error, doubles up to 5 minutes
